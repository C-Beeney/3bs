: "If dev-test passed, enable debug and shift arg"
devtest_toggle=0
if test "${1-}" = "dev-test"
then
    shift
    devtest_toggle=1
    set -x
fi

if test "_${1-}" = "_perform"
then
    shift

    : "If 'clean' argument is given, remove test directory"
    if test "_${1-}" = "_clean"
    then
        rm -fr "`pwd`/test"

        exit
    fi

    : "Create test directory if it does not exist and populate it"
    if test "_${1-}" = "_install"
    then

        if test -d "test"
        then
            rm -fr test
        fi

        mkdir test && cp -fa `printf "%s\n" .* * | sed '/^\.\{1,2\}$/d; /test/d'` test/
        rm -fr test/test ;: "Remove nested test dir"

        : "Run install script in test dir to set up 3bs there, clean on fail"
        (
            cd test
            sh -c ".3bs/install `test $devtest_toggle -eq 1 && echo 'dev-test'`"
        )

        status=$?
        if test "$status" -ne 0
        then rm -fr test && exit "$status"
        fi

        exit 0
    fi
fi